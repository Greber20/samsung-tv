<?xml version="1.0" encoding="UTF-8"?>
<!-- Samsung TV (Tizen) app wrapper for the home screen. Built by tv-app/build.ps1. -->
<widget xmlns="http://www.w3.org/ns/widgets" xmlns:tizen="http://tizen.org/ns/widgets"
        id="https://greber20.github.io/samsung-tv" version="1.0.0" viewmodes="maximized">
  <tizen:application id="GrAnHome01.SamsungTV" package="GrAnHome01" required_version="6.0"/>
  <tizen:profile name="tv-samsung"/>
  <name>Graden &amp; Annyka</name>
  <content src="index.html"/>
  <icon src="icon.jpg"/>

  <!-- Open Netflix and the other apps, find their ids, and receive the remote's media keys. -->
  <tizen:privilege name="http://tizen.org/privilege/application.launch"/>
  <tizen:privilege name="http://tizen.org/privilege/application.info"/>
  <tizen:privilege name="http://tizen.org/privilege/tv.inputdevice"/>
  <tizen:privilege name="http://tizen.org/privilege/internet"/>

  <!-- Songs play in Suno's embed; song and photo lists refresh from GitHub Pages. -->
  <access origin="*" subdomains="true"/>
  <tizen:allow-navigation>*</tizen:allow-navigation>

  <tizen:setting screen-orientation="landscape" context-menu="disable" background-support="disable"
                 encryption="disable" install-location="auto" hwkey-event="enable"/>
</widget>
